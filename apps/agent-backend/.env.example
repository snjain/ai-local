# Backend-specific environment variables
# The backend primarily reads from the root .env file,
# but you can override values here if needed.

LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_CHOICE=qwen2.5:7b-instruct-q4_K_M

EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL_CHOICE=nomic-embed-text

SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_SERVICE_KEY=your-service-role-key

DATABASE_URL=postgresql://postgres:your-password@127.0.0.1:5434/postgres

BRAVE_API_KEY=
SEARXNG_BASE_URL=http://127.0.0.1:8080
