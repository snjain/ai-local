# ============================================================
# n8n Configuration
# ============================================================
N8N_ENCRYPTION_KEY=your-secure-random-key-min-16-chars
N8N_USER_MANAGEMENT_JWT_SECRET=your-secure-jwt-secret-min-16-chars

# ============================================================
# LLM Configuration (Ollama — local default)
# ============================================================
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_CHOICE=qwen2.5:7b-instruct-q4_K_M
VISION_LLM_CHOICE=llava:7b

# Optional: OpenAI / OpenRouter
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-api-key
# LLM_CHOICE=gpt-4o-mini

# ============================================================
# Embedding Configuration (Ollama — local default)
# ============================================================
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL_CHOICE=nomic-embed-text

# Optional: OpenAI embeddings
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-your-openai-api-key
# EMBEDDING_MODEL_CHOICE=text-embedding-3-small

# ============================================================
# Database (Local Supabase via Docker)
# ============================================================
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5435
POSTGRES_USER=postgres
DATABASE_URL=postgresql://postgres:your-postgres-password@127.0.0.1:5434/postgres

# Supabase URLs (local Docker stack)
SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3Nzg5OTA0MDAsImV4cCI6MTkzNjc1NjgwMH0.5L4ZqqknMK19vq-RxUu27pycuCanuzwsJ9AJE7y_o0Q
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzc4OTkwNDAwLCJleHAiOjE5MzY3NTY4MDB9.UIu301iB3XGhh7F2VLlwiQf6MAsElsNL_sREjGXDD1o
SERVICE_ROLE_KEY=${SUPABASE_SERVICE_KEY}

# JWT (from Supabase setup)
JWT_SECRET=your-jwt-secret
JWT_EXPIRY=3600

# ============================================================
# Web Search
# ============================================================
# Optional: Brave Search API
BRAVE_API_KEY=your-brave-api-key

# Local SearXNG (runs in Docker stack)
SEARXNG_BASE_URL=http://searxng:8080

# ============================================================
# Frontend Environment Variables
# ============================================================
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzc4OTkwNDAwLCJleHAiOjE5MzY3NTY4MDB9.UIu301iB3XGhh7F2VLlwiQf6MAsElsNL_sREjGXDD1o
VITE_AGENT_ENDPOINT=http://localhost:8009/api/pydantic-agent
VITE_ENABLE_STREAMING=true

# ============================================================
# Langfuse (Optional — runs in Docker stack)
# ============================================================
LANGFUSE_SALT=your-salt-value
ENCRYPTION_KEY=your-encryption-key
CLICKHOUSE_PASSWORD=your-clickhouse-password
MINIO_ROOT_PASSWORD=your-minio-password
NEXTAUTH_SECRET=your-nextauth-secret

# ============================================================
# RAG Pipeline Configuration
# ============================================================
RAG_PIPELINE_TYPE=local
RUN_MODE=continuous
RAG_WATCH_DIRECTORY=./shared

# ============================================================
# Deployment / Infrastructure
# ============================================================
ENVIRONMENT=development

# Caddy hostnames (optional — for local reverse proxy)
# N8N_HOSTNAME=n8n.localhost
# SUPABASE_HOSTNAME=supabase.localhost
# SEARXNG_HOSTNAME=searxng.localhost
# AGENT_HOSTNAME=agent.localhost
# AGENT_UI_HOSTNAME=chat.localhost
